# Copy to .env.local for local development; application.properties imports ./.env.local.
# Never commit real values. Keys not listed here use local-friendly defaults
# (API/file URLs on localhost:8080, CORS for localhost:5173, uploads in ~/.adlips/uploads).

# Local infrastructure started with deploy/build/docker-compose.yml
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/adlips
SPRING_DATASOURCE_USERNAME=adlips
SPRING_DATASOURCE_PASSWORD=change-me-local
SPRING_JPA_HIBERNATE_DDL_AUTO=update

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=change-me-local
# Redis 6+ ACL account; leave commented to authenticate as the default user.
# REDIS_USERNAME=
# Prefix of every Redis key ("<prefix>:..."); must match the account's ACL key pattern. Default narackrock.
# REDIS_KEY_PREFIX=narackrock

# Authentication
# Required: signs access/refresh tokens; at least 32 random characters (openssl rand -hex 32).
APP_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Google web OAuth client ID, the same value as the frontend's VITE_GOOGLE_CLIENT_ID.
# Login fails while it is empty. No client secret is needed: the backend only verifies Google ID tokens.
GOOGLE_CLIENT_ID=

# Frontend origins allowed for HTTP CORS and the chat WebSocket (comma-separated).
ADLIPS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
