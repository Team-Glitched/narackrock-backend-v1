# Environment for deploy/build/docker-compose.yml, copied to deploy/env/.env.
# Never commit real values. Commented keys are optional: leave them commented to keep the
# application default (an empty "KEY=" overrides the default with an empty string).

# Application container
ADLIPS_APP_IMAGE=adlips-backend:latest
ADLIPS_APP_BIND_ADDRESS=127.0.0.1
ADLIPS_APP_PORT=8080
# Host directory mounted at /var/lib/adlips/storage (uploads and rendered mixes, served under /files)
ADLIPS_STORAGE_PATH=/var/lib/adlips/storage
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Seoul
TZ=Asia/Seoul

# PostgreSQL. docker-compose.yml passes these to the backend as SPRING_DATASOURCE_*.
POSTGRES_DB=adlips
POSTGRES_USER=adlips
POSTGRES_PASSWORD=change-me
POSTGRES_LOCAL_PORT=15432
# "update" creates new tables such as editor_drafts. With validate/none, apply docs/editor-drafts.sql first.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis. docker-compose.yml passes REDIS_HOST/REDIS_PORT to the backend.
REDIS_PASSWORD=change-me
REDIS_LOCAL_PORT=16379
# REDIS_CONNECT_TIMEOUT=2s
# REDIS_COMMAND_TIMEOUT=2s

# Authentication
# Signs access/refresh tokens; at least 32 random characters (openssl rand -hex 32).
APP_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Google web OAuth client ID, the same one the frontend uses. Login fails while it is empty.
# No client secret is needed: the backend only verifies Google ID tokens.
GOOGLE_CLIENT_ID=
# APP_AUTH_TOKEN_VALIDITY_SECONDS=900
# APP_AUTH_REFRESH_TOKEN_VALIDITY_SECONDS=2592000

# Public API URLs
ADLIPS_API_PUBLIC_URL=https://api.example.com
ADLIPS_PUBLIC_FILE_URL=https://api.example.com/files

# Frontend origins and share links
ADLIPS_CORS_ALLOWED_ORIGINS=https://example.com
ADLIPS_PROFILE_SHARE_URL=https://example.com/users/profiles
ADLIPS_SHORTS_SHARE_URL=https://example.com/shorts
ADLIPS_POST_SHARE_URL=https://example.com/posts
ADLIPS_OPENSOURCE_SHARE_URL=https://example.com/opensource

# Open-source signed playback links
# Separate signing key, at least 32 characters; defaults to APP_AUTH_TOKEN_SECRET.
# ADLIPS_OPENSOURCE_PLAYBACK_SECRET=
# ADLIPS_OPENSOURCE_PLAYBACK_TTL_SECONDS=600

# HTI audio-to-MIDI service, reachable from the backend container.
# The default http://localhost:8000 points at the container itself, so conversion fails until this is set.
# HTI_SERVICE_BASE_URL=http://hti.example.internal:8000

# Upload limits
# ADLIPS_MULTIPART_MAX_FILE_SIZE=25MB
# ADLIPS_MULTIPART_MAX_REQUEST_SIZE=25MB

# Background jobs (application defaults shown)
# REDIS_VIEW_DEDUPLICATION_WINDOW=PT30M
# REDIS_VIEW_SYNC_ENABLED=true
# REDIS_VIEW_SYNC_INTERVAL=PT10S
# REDIS_VIEW_SYNC_INITIAL_DELAY=PT10S
# REDIS_VIEW_SYNC_BATCH_SIZE=100
# REDIS_SHORT_REACTION_CACHE_TTL=PT10M
# PROJECT_EXPORT_PROCESSING_ENABLED=true
# PROJECT_EXPORT_PROCESSING_INTERVAL=PT5S
# PROJECT_EXPORT_PROCESSING_INITIAL_DELAY=PT5S
# PROJECT_EXPORT_PROCESSING_BATCH_SIZE=5
